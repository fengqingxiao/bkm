le":false,"@repeat":false}]},{"code":509,"indent":0,"params":[{"__class":"RPG::MoveCommand","@parameters":[],"@code":17}]},{"code":101,"indent":0,"params":["\\xn[莱兰]\\PN，你可以走了。"]},{"code":101,"indent":0,"params":["\\xn[莱兰]黛丝蒂妮应该很快就到，到时候\\n我们再谈谈关于她能力的事。"]},{"code":101,"indent":0,"params":["\\b等等。"]},{"code":101,"indent":0,"params":["\\b薇薇。"]},{"code":101,"indent":0,"params":["\\xn[薇薇]怎么了？"]},{"code":209,"indent":0,"params":[3,{"__class":"RPG::MoveRoute","@list":[{"__class":"RPG::MoveCommand","@parameters":[],"@code":19},{"__class":"RPG::MoveCommand","@parameters":[],"@code":0}],"@skippable":false,"@repeat":false}]},{"code":509,"indent":0,"params":[{"__class":"RPG::MoveCommand","@parameters":[],"@code":19}]},{"code":209,"indent":0,"params":[4,{"__class":"RPG::MoveRoute","@list":[{"__class":"RPG::MoveCommand","@parameters":[],"@code":19},{"__class":"RPG::MoveCommand","@parameters":[],"@code":0}],"@skippable":false,"@repeat":false}]},{"code":509,"indent":0,"params":[{"__class":"RPG::MoveCommand","@parameters":[],"@code":19}]},{"code":101,"indent":0,"params":["\\b你愿不愿意…"]},{"code":101,"indent":0,"params":["\\b你愿不愿意和我们并肩作战？"]},{"code":101,"indent":0,"params":["\\xn[薇薇]对抗谁？"]},{"code":101,"indent":0,"params":["\\b达雷思和切尔茜。"]},{"code":101,"indent":0,"params":["\\b他们是追杀你的人，对吧？"]},{"code":101,"indent":0,"params":["\\b就算我们全员出动，这场仗也不会\\n轻松。"]},{"code":101,"indent":0,"params":["\\b肯定会有很多同伴牺牲。"]},{"code":101,"indent":0,"params":["\\b但如果我们有两位守护者，或许——"]},{"code":101,"indent":0,"params":["\\xn[薇薇]你未必会希望我参战。"]},{"code":101,"indent":0,"params":["\\b啊——"]},{"code":101,"indent":0,"params":["\\b为什么？"]},{"code":101,"indent":0,"params":["\\xn[薇薇]如果他们杀了我，就能夺取我的力量。"]},{"code":101,"indent":0,"params":["\\xn[薇薇]得到我的力量，他们就会毁灭我们\\n的世界。"]},{"code":106,"indent":0,"params":[10]},{"code":101,"indent":0,"params":["\\xn[薇薇]另外，你之前不是也提到过，在你\\n失忆前，"]},{"code":101,"indent":0,"params":["\\xn[薇薇]你也和他们一样，在追捕我吗？"]},{"code":101,"indent":0,"params":["\\b是啊…我想你说得对。"]},{"code":101,"indent":0,"params":["\\xn[薇薇]但或许有一件事我能为你做到。"]},{"code":101,"indent":0,"params":["\\xn[薇薇]创造守护者本身并不具备特别强大\\n的力量。"]},{"code":101,"indent":0,"params":["\\xn[薇薇]但是，如果我能和另一位守护者有\\n物理接触，我们就能互相增强彼此\\n的力量。"]},{"code":101,"indent":0,"params":["\\xn[莱兰]所以如果你触碰\\PN，你就\\n能让他飞得更快之类的？"]},{"code":101,"indent":0,"params":["\\xn[薇薇]没错。"]},{"code":101,"indent":0,"params":["\\xn[薇薇]但这仍不足以说服我与你们并肩作战。"]},{"code":101,"indent":0,"params":["\\xn[莱兰]所以你到底想说什么？"]},{"code":101,"indent":0,"params":["\\xn[薇薇]风之守护者拥有一种特殊的力量，\\n可以回看自己的任何一段记忆。"]},{"code":101,"indent":0,"params":["\\xn[薇薇]或是，他们所触碰的人或地方的记忆。"]},{"code":101,"indent":0,"params":["\\xn[薇薇]这是一种非常精细的能力，需要数\\n年才能掌握。"]},{"code":101,"indent":0,"params":["\\xn[薇薇]但如果再多一位守护者，我就能获\\n得足够力量来加速\\PN掌握\\n该项能力的过程。"]},{"code":101,"indent":0,"params":["\\xn[莱兰]所以你果然知道的比你透露的要多。"]},{"code":101,"indent":0,"params":["\\xn[薇薇]你们把我一个人丢在房子里整整一周，\\n连个说话的人都没有。"]},{"code":101,"indent":0,"params":["\\xn[薇薇]我只是想让我们的对话能持续得更\\n久一点，如果我一上来就把所有答\\n案都告诉你们，那不就没得聊了吗？"]},{"code":101,"indent":0,"params":["\\xn[莱兰]天哪——"]},{"code":101,"indent":0,"params":["\\xn[莱兰]啊，算了。"]},{"code":101,"indent":0,"params":["\\xn[薇薇]关于艾伊莫纳克或是它之外的世界，\\n我依然一无所知。"]},{"code":101,"indent":0,"params":["\\xn[薇薇]但我可以告诉你达雷思和切尔茜的\\n守护者的详细信息。"]},{"code":106,"indent":0,"params":[10]},{"code":101,"indent":0,"params":["\\xn[泽维尔]嗯…"]},{"code":101,"indent":0,"params":["\\xn[泽维尔]回看所触碰的人和地方的记忆…"]},{"code":101,"indent":0,"params":["\\xn[泽维尔]那不就意味着\\PN可以找回\\n自己全部的记忆了？"]},{"code":101,"indent":0,"params":["\\xn[莱兰]他不是失忆了吗？这真的能起作用？"]},{"code":101,"indent":0,"params":["\\b我…确实偶尔会看到一些奇怪的幻象，\\n有时是在梦里，有时会突然凭空出现。"]},{"code":101,"indent":0,"params":["\\b那些记忆毫无疑问还在我脑海里。"]},{"code":101,"indent":0,"params":["\\xn[泽维尔]太好了！只要我们杀一个守护者，\\n然后就能知道我们想知道的任何事了。"]},{"code":209,"indent":0,"params":[3,{"__class":"RPG::MoveRoute","@list":[{"__class":"RPG::MoveCommand","@parameters":[],"@code":17},{"__class":"RPG::MoveCommand","@parameters":[],"@code":0}],"@skippable":false,"@repeat":false}]},{"code":509,"indent":0,"params":[{"__class":"RPG::MoveCommand","@parameters":[]