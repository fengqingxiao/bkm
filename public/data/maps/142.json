n[莱拉]在我出门时，父亲给了我一些钱\\n和一个包裹。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]比平时给的钱要多不少。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]他让我把包裹送到邻镇的一个人\\n手里。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]名字我记不清了。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]他还告诉我，可以给自己买点好\\n东西作为奖励。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]我兴奋地想着该怎么花掉这笔钱，\\n急急忙忙地赶去了附近的村子。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]但是，那里根本没有要我送包裹\\n的人。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]我觉得自己的任务失败了，就没\\n好意思花那笔钱，直接回家了。"]},{"code":106,"indent":0,"params":[10]},{"code":101,"indent":0,"params":["\\xn[莱拉]回家的路上。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]我越走...越近。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]烟味越来越浓，空气越来越稀薄。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]我从快步走变成小跑，没过多久，\\n就变成了狂奔。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]妈妈。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]爸爸。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]艾文。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]你们会没事的。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]这才过了几个小时而已。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]妈妈，我们今晚就去田野里采花。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]爸爸，明天我们去森林里练习宝\\n可梦对战。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]艾文，后天我们去湖边钓蚊香蝌\\n蚪。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]一切都没了。"]},{"code":106,"indent":0,"params":[10]},{"code":101,"indent":0,"params":["\\xn[莱拉]整个村庄，烧成了灰烬。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]我们打水的井，没了。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]我为了赚零花钱而照料的老奶奶\\n的庄稼，没了。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]我的房子，只剩下残骸。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]我母亲的手臂，是那堆瓦砾下唯\\n一能看到的东西。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]我父亲的腿，从树后隐约可见，\\n但我...我不敢再看下去了。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]而艾文，哪里都找不到他。"]},{"code":106,"indent":0,"params":[10]},{"code":101,"indent":0,"params":["\\xn[莱拉]我哭了。"]},{"code":106,"indent":0,"params":[10]},{"code":101,"indent":0,"params":["\\xn[莱拉]我一直哭到筋疲力尽。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]当我最后打开那个包裹时，里面\\n只有一张纸条和一些钱。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]”对不起，斯凯拉。”"]},{"code":101,"indent":0,"params":["\\xn[莱拉]”对不起，我没能挽回这一切。”"]},{"code":101,"indent":0,"params":["\\xn[莱拉]”请你，好好活下去。”"]},{"code":101,"indent":0,"params":["\\xn[莱拉]当时我不明白。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]现在我依然不明白。"]},{"code":106,"indent":0,"params":[15]},{"code":101,"indent":0,"params":["\\b(自始至终，我都在等着她哭出来，\\n或者至少停下来)"]},{"code":101,"indent":0,"params":["\\b(但她的脸上，却看不到一丝生气\\n或情感。)"]},{"code":101,"indent":0,"params":["\\b(莱拉难道......已经麻木了吗？)"]},{"code":101,"indent":0,"params":["\\b(过去的四个月里，我们到底错过\\n了多少?)"]},{"code":101,"indent":0,"params":["\\xn[黛丝蒂妮]莱拉..."]},{"code":101,"indent":0,"params":["\\xn[黛丝蒂妮]我向你保证。"]},{"code":101,"indent":0,"params":["\\xn[黛丝蒂妮]我们一定会消灭反叛军，让他们\\n为自己的所作所为付出代价！"]},{"code":106,"indent":0,"params":[15]},{"code":101,"indent":0,"params":["\\xn[莱拉]不，我不想那样..."]},{"code":207,"indent":0,"params":[-1,3]},{"code":207,"indent":0,"params":[3,3]},{"code":106,"indent":0,"params":[15]},{"code":101,"indent":0,"params":["\\xn[黛丝蒂妮]诶-诶..?!"]},{"code":101,"indent":0,"params":["\\xn[莱拉]我只是——"]},{"code":101,"indent":0,"params":["\\xn[黛丝蒂妮]他们都对你做了那样的事了？！"]},{"code":101,"indent":0,"params":["\\xn[莱拉]想找到我的弟弟..."]},{"code":101,"indent":0,"params":["\\xn[黛丝蒂妮]而且他们也夺走了我的幸福..."]},{"code":101,"indent":0,"params":["\\xn[莱拉]然后逃离这里。"]},{"code":101,"indent":0,"params":["\\xn[黛丝蒂妮]你为什么就不想反抗呢，该死的！"]},{"code":101,"indent":0,"params":["\\xn[莱拉]我就是不想！"]},{"code":101,"indent":0,"params":["\\xn[莱拉]因为这个世界上其他任何事我都\\n不在乎！"]},{"code":101,"indent":0,"params":["\\xn[莱拉]我只想逃得远远的，和我仅存的\\n家人开始新的生活！！"]},{"code":106,"indent":0,"params":[20]},{"code":101,"indent":0,"params":["\\xn[莱拉]我出去透透气。"]},{"code":209,"indent":0,"params":[2,{"__class":"RPG::MoveRoute","@list":[{"__class":"RPG::MoveCommand","@parameters":[],"@code":3},{"__class":"RPG::MoveCommand","@parameters":[],"@code":3},{"__class":"RPG::MoveCommand","@parameters":[],"@code":1},{"__class":"RPG::MoveCommand","@parameters":[],"@code":1},{"__class":"RPG::M