landphone",0,2,2],"@code":41}]},{"code":101,"indent":0,"params":["\\xn[莱兰]所以你他妈到底想怎样？"]},{"code":101,"indent":0,"params":["\\xn[主席]我听说你昨天跟那个老帮派首领\\n交手了，你又没能抓住他？"]},{"code":207,"indent":0,"params":[2,3]},{"code":106,"indent":0,"params":[20]},{"code":209,"indent":0,"params":[2,{"__class":"RPG::MoveRoute","@list":[{"__class":"RPG::MoveCommand","@parameters":["Rylandphone",0,2,1],"@code":41},{"__class":"RPG::MoveCommand","@parameters":[],"@code":0}],"@skippable":false,"@repeat":false}]},{"code":509,"indent":0,"params":[{"__class":"RPG::MoveCommand","@parameters":["Rylandphone",0,2,1],"@code":41}]},{"code":101,"indent":0,"params":["\\xn[莱兰]是啊，我又让他跑了。"]},{"code":101,"indent":0,"params":["\\xn[主席]如果你愿意，我随时可以把你调\\n到别的岗——"]},{"code":209,"indent":0,"params":[2,{"__class":"RPG::MoveRoute","@list":[{"__class":"RPG::MoveCommand","@parameters":["Rylandphone",0,2,3],"@code":41},{"__class":"RPG::MoveCommand","@parameters":[],"@code":0}],"@skippable":false,"@repeat":false}]},{"code":509,"indent":0,"params":[{"__class":"RPG::MoveCommand","@parameters":["Rylandphone",0,2,3],"@code":41}]},{"code":101,"indent":0,"params":["\\xn[莱兰]不必。"]},{"code":101,"indent":0,"params":["\\xn[主席]你知道的，自从他在莱文丹解散\\n了他的帮派之后，他的赏金就已\\n经大幅下降了。"]},{"code":106,"indent":0,"params":[15]},{"code":101,"indent":0,"params":["\\xn[莱兰]该死！"]},{"code":101,"indent":0,"params":["\\xn[莱兰]这跟钱没关系，是我要给这段恩\\n怨做个了结。"]},{"code":101,"indent":0,"params":["\\xn[莱兰]我要去宰——"]},{"code":101,"indent":0,"params":["\\xn[莱兰]我要去将那个男人绳之以法。"]},{"code":101,"indent":0,"params":["\\xn[主席]还真没看出来你是这种高尚的人，\\n但不管怎样，我叫你来不是为了\\n这事。"]},{"code":101,"indent":0,"params":["\\xn[主席]你还碰见个训练家，好像叫\\n\\PN？"]},{"code":101,"indent":0,"params":["\\xn[莱兰]是的，火车被劫持的时候他就在\\n车上。"]},{"code":101,"indent":0,"params":["\\xn[莱兰]还有另外三个训练家，其中一个\\n是伊泽卡·泽克。"]},{"code":101,"indent":0,"params":["\\xn[主席]莱兰，这个叫\\PN的家伙有什\\n么让你觉得特别的地方吗？"]},{"code":101,"indent":0,"params":["\\xn[莱兰]没什么特别的，看起来就是个普\\n通的训练家。"]},{"code":101,"indent":0,"params":["\\xn[莱兰]我只看到了他和帮派首领对战\\n的结尾，他输了。"]},{"code":101,"indent":0,"params":["\\xn[莱兰]怎么了？"]},{"code":101,"indent":0,"params":["\\xn[主席]没什么，随便问问。"]},{"code":101,"indent":0,"params":["\\xn[主席]好了，祝你在东南部玩得愉快。"]},{"code":250,"indent":0,"params":[{"__class":"RPG::AudioFile","@volume":80,"@name":"computerclose","@pitch":90}]},{"code":207,"indent":0,"params":[2,3]},{"code":106,"indent":0,"params":[10]},{"code":209,"indent":0,"params":[2,{"__class":"RPG::MoveRoute","@list":[{"__class":"RPG::MoveCommand","@parameters":["NPC 38",0,2,0],"@code":41},{"__class":"RPG::MoveCommand","@parameters":[],"@code":0}],"@skippable":false,"@repeat":false}]},{"code":509,"indent":0,"params":[{"__class":"RPG::MoveCommand","@parameters":["NPC 38",0,2,0],"@code":41}]},{"code":101,"indent":0,"params":["\\xn[莱兰]那个混蛋大清早把我叫起来，就\\n是为了问一个不相干的训练家..."]},{"code":101,"indent":0,"params":["\\xn[莱兰] 真烦人。"]},{"code":117,"indent":0,"params":[4]},{"code":106,"indent":0,"params":[50]},{"code":122,"indent":0,"params":[65,65,0,0,40]},{"code":101,"indent":0,"params":["<ac>\\l[3]第十七章\\n谙弥利亚家族\\n等级上限：40"]},{"code":122,"indent":0,"params":[91,91,0,0,14]},{"code":122,"indent":0,"params":[92,92,0,0,1]},{"code":208,"indent":0,"params":[1]},{"code":201,"indent":0,"params":[0,102,4,13,0,0]},{"code":106,"indent":0,"params":[50]},{"code":241,"indent":0,"params":[{"__class":"RPG::AudioFile","@volume":100,"@name":"Pokémon Center Theme Lofi Lullaby Remix","@pitch":100}]},{"code":117,"indent":0,"params":[6]},{"code":101,"indent":0,"params":["\\b(好了，该去找黛丝蒂妮了。)"]},{"code":117,"indent":0,"params":[3]},{"code":355,"indent":0,"params":["activateQuest(:Quest29, colorQuest(\"red\"))"]},{"code":0,"indent":0,"params":[]}]}]},{"id":2,"name":"Ryland","x":10,"y":9,"pages":[{"trigger":0,"moveType":0,"moveSpeed":3,"moveFrequency":3,"walkAnime":true,"stepAnime":false,"directionFix":false,"through":false,"alwaysOnTop":false,"condition":{"switch1Valid":false,"switch1":1,"switch2Valid":false,"switch2":1,"variableValid":true,"variable":91,"variableValue":13,"selfSwitch":""},"graphic":{"tileId":0,"c