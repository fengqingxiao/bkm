arams":[10]},{"code":101,"indent":0,"params":["\\xn[基思]抱歉久等了，你们现在可以进我\\n的办公室了。"]},{"code":117,"indent":0,"params":[4]},{"code":202,"indent":0,"params":[2,0,8,7,0]},{"code":202,"indent":0,"params":[3,0,10,7,0]},{"code":201,"indent":0,"params":[0,167,9,6,0,0]},{"code":117,"indent":0,"params":[6]},{"code":101,"indent":0,"params":["\\xn[康纳]既然人都到齐了，我们就来谈谈\\n你们的情况吧。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]先生抱歉，很抱歉打断您。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]但我恳求您不要把我弟弟关进监\\n狱。"]},{"code":101,"indent":0,"params":["\\xn[莱拉]我知道他曾是个叛变者，\\n但求您了，他还只是个孩子.."]},{"code":101,"indent":0,"params":["\\xn[莱拉]如果可以，我愿意替他接受任何\\n惩罚，甚至加倍也行。"]},{"code":209,"indent":0,"params":[2,{"__class":"RPG::MoveRoute","@list":[{"__class":"RPG::MoveCommand","@parameters":[],"@code":18},{"__class":"RPG::MoveCommand","@parameters":[],"@code":0}],"@skippable":false,"@repeat":false}]},{"code":509,"indent":0,"params":[{"__class":"RPG::MoveCommand","@parameters":[],"@code":18}]},{"code":101,"indent":0,"params":["\\xn[艾文]斯-斯凯拉！"]},{"code":209,"indent":0,"params":[2,{"__class":"RPG::MoveRoute","@list":[{"__class":"RPG::MoveCommand","@parameters":[],"@code":19},{"__class":"RPG::MoveCommand","@parameters":[],"@code":0}],"@skippable":false,"@repeat":false}]},{"code":509,"indent":0,"params":[{"__class":"RPG::MoveCommand","@parameters":[],"@code":19}]},{"code":101,"indent":0,"params":["\\xn[基思]等一下.."]},{"code":101,"indent":0,"params":["\\xn[基思]我们这还一句话都没说呢。"]},{"code":101,"indent":0,"params":["\\xn[基思]能不能先听我们把话说完？"]},{"code":101,"indent":0,"params":["\\xn[莱拉]…"]},{"code":101,"indent":0,"params":["\\xn[基思]是的，你弟弟确实被认定为叛变者，\\n根据法律我们必须惩罚他。"]},{"code":101,"indent":0,"params":["\\xn[基思]但是！"]},{"code":101,"indent":0,"params":["\\xn[基思]我们审问了抓到的其他反叛军成员，\\n他们中的大多数人都主动提\\n供了一些关于艾文的情报。"]},{"code":101,"indent":0,"params":["\\xn[基思]很抱歉提及此事，但赞斯确实用\\n艾文家人还活着的谎言操纵他，\\n让他替他们干脏活。"]},{"code":101,"indent":0,"params":["\\xn[基思]最重要的是，艾文今年才十四岁。"]},{"code":101,"indent":0,"params":["\\xn[基思]所以，我给你们两个选择。"]},{"code":101,"indent":0,"para